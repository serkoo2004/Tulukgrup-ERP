APP_NAME="Tuluklar ERP"
APP_ENV=local

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.106:5173,http://100.95.238.26:5173
RATE_LIMIT_PER_MINUTE=120
DATABASE_URL=postgres://erp_user:erp_password@localhost:5432/tuluklar_erp
STORAGE_ROOT=./storage
BACKUP_DIR=./backups
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

BOOTSTRAP_ADMIN_EMAIL=admin@tuluklar.local
BOOTSTRAP_ADMIN_PASSWORD=Admin12345!

AI_PROVIDER=disabled
AI_MODEL=not-configured
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
# Local AI example:
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1
# AI_BASE_URL=http://127.0.0.1:11434

WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=tr
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

REALTIME_HOST=0.0.0.0
REALTIME_WS_PORT=8090
REALTIME_TCP_PORT=7070
